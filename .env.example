# All values optional at runtime - the UI can supply tokens per request.
# Figma personal access token (URL and combined modes only)
FIGMA_TOKEN=
# Fine-grained GitHub PAT with the "Copilot Requests" permission
GITHUB_PAT=
# Default model id, e.g. gpt-4.1 / claude-sonnet-4.5 ("auto" lets Copilot choose)
FIGMA_TO_REACT_MODEL=auto
# Hard cap on model turns per conversion (protects your Copilot quota)
FIGMA_TO_REACT_MAX_MODEL_CALLS=12
# Output + working directories
FIGMA_TO_REACT_OUT_ROOT=generated
OPIK_ENABLED=true
OPIK_API_KEY=<from comet.com>
OPIK_WORKSPACE=<your workspace>